# QuickShell Ballade - USB Audio Notification Rules
# Triggers user systemd service on USB plug in/out
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="usb-audio@add.service"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="usb-audio@remove.service"
