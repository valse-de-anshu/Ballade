# Ballade Pink (Sakura Dark) micro colorscheme
color-link default "#fce4ec,#181216"
color-link colorcolumn "#fce4ec,#261922"
color-link line-number "#7a5068,#181216"
color-link current-line-number "#f06292,#181216"
color-link cursor-line "#fce4ec,#261922"
color-link statusline "#ffffff,#351e2e"
color-link statusline.error "#ff1744,#351e2e"
color-link tabbar "#b388a4,#351e2e"
color-link tab-active "#ffffff,#181216"
color-link tab-inactive "#b388a4,#351e2e"
color-link error "#ff1744"
color-link warning "#ffd54f"
color-link todo "#ff80ab"
color-link selection "#ffffff,#4a2840"
color-link search-result "#181216,#f06292"
color-link diff-added "#81c784"
color-link diff-removed "#ff1744"
color-link diff-modified "#ffd54f"
color-link comment "#7a5068"
color-link comment.hashbang "#7a5068"
color-link constant "#ffd54f"
color-link constant.number "#ff80ab"
color-link constant.bool "#ff80ab"
color-link constant.string "#f48fb1"
color-link constant.string.url "#f06292"
color-link constant.specialChar "#ff4081"
color-link identifier "#fce4ec"
color-link identifier.var "#fce4ec"
color-link identifier.macro "#ff80ab"
color-link identifier.class "#e05688"
color-link statement "#ff4081"
color-link preproc "#f06292"
color-link type "#e05688"
color-link special "#ff80ab"
color-link underlined "underline #f06292"
color-link symbol "#ff4081"
color-link divider "#261922"
