# Ballade Purple (Amethyst Dark) micro colorscheme
color-link default "#ede7f6,#15111e"
color-link colorcolumn "#ede7f6,#241c33"
color-link line-number "#6b5887,#15111e"
color-link current-line-number "#ba68c8,#15111e"
color-link cursor-line "#ede7f6,#241c33"
color-link statusline "#ffffff,#322547"
color-link statusline.error "#ff5252,#322547"
color-link tabbar "#b39ddb,#322547"
color-link tab-active "#ffffff,#15111e"
color-link tab-inactive "#b39ddb,#322547"
color-link error "#ff5252"
color-link warning "#ffd740"
color-link todo "#e040fb"
color-link selection "#ffffff,#483266"
color-link search-result "#15111e,#ba68c8"
color-link diff-added "#69f0ae"
color-link diff-removed "#ff5252"
color-link diff-modified "#ffd740"
color-link comment "#6b5887"
color-link comment.hashbang "#6b5887"
color-link constant "#ffd740"
color-link constant.number "#e040fb"
color-link constant.bool "#e040fb"
color-link constant.string "#ce93d8"
color-link constant.string.url "#ba68c8"
color-link constant.specialChar "#ab47bc"
color-link identifier "#ede7f6"
color-link identifier.var "#ede7f6"
color-link identifier.macro "#e040fb"
color-link identifier.class "#9c27b0"
color-link statement "#ab47bc"
color-link preproc "#ba68c8"
color-link type "#9c27b0"
color-link special "#e040fb"
color-link underlined "underline #ba68c8"
color-link symbol "#ab47bc"
color-link divider "#241c33"
