# Ballade Catppuccin Mocha micro colorscheme
color-link default "#cdd6f4,#1e1e2e"
color-link colorcolumn "#cdd6f4,#313244"
color-link line-number "#6c7086,#1e1e2e"
color-link current-line-number "#cba6f7,#1e1e2e"
color-link cursor-line "#cdd6f4,#313244"
color-link statusline "#cdd6f4,#181825"
color-link statusline.error "#f38ba8,#181825"
color-link tabbar "#a6adc8,#181825"
color-link tab-active "#cdd6f4,#1e1e2e"
color-link tab-inactive "#a6adc8,#181825"
color-link error "#f38ba8"
color-link warning "#f9e2af"
color-link todo "#cba6f7"
color-link selection "#cdd6f4,#585b70"
color-link search-result "#1e1e2e,#cba6f7"
color-link diff-added "#a6e3a1"
color-link diff-removed "#f38ba8"
color-link diff-modified "#f9e2af"
color-link comment "#6c7086"
color-link comment.hashbang "#6c7086"
color-link constant "#fab387"
color-link constant.number "#fab387"
color-link constant.bool "#fab387"
color-link constant.string "#a6e3a1"
color-link constant.string.url "#89dceb"
color-link constant.specialChar "#f5c2e7"
color-link identifier "#cdd6f4"
color-link identifier.var "#cdd6f4"
color-link identifier.macro "#cba6f7"
color-link identifier.class "#f9e2af"
color-link statement "#cba6f7"
color-link preproc "#f5c2e7"
color-link type "#89b4fa"
color-link special "#f5c2e7"
color-link underlined "underline #89dceb"
color-link symbol "#f5c2e7"
color-link divider "#313244"
