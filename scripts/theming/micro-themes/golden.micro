# Ballade Luminous Gold micro colorscheme
color-link default "#ebd8a0,#1c1810"
color-link colorcolumn "#ebd8a0,#261f14"
color-link line-number "#6b5839,#1c1810"
color-link current-line-number "#f0b849,#1c1810"
color-link cursor-line "#ebd8a0,#261f14"
color-link statusline "#1c1810,#f0b849"
color-link statusline.error "#ffffff,#c86a3b"
color-link tabbar "#ebd8a0,#2e2414"
color-link tab-active "#1c1810,#f0b849"
color-link tab-inactive "#ebd8a0,#2e2414"
color-link error "#c86a3b"
color-link warning "#fed268"
color-link todo "#f0b849"
color-link selection "#1c1810,#f0b849"
color-link search-result "#1c1810,#fed268"
color-link diff-added "#a8b340"
color-link diff-removed "#c86a3b"
color-link diff-modified "#f0b849"
color-link comment "#7a6744"
color-link comment.hashbang "#7a6744"
color-link constant "#fed268"
color-link constant.number "#e0ad4f"
color-link constant.bool "#e0ad4f"
color-link constant.string "#a8b340"
color-link constant.string.url "#cbb06d"
color-link constant.specialChar "#f0b849"
color-link identifier "#ebd8a0"
color-link identifier.var "#ebd8a0"
color-link identifier.macro "#f0b849"
color-link identifier.class "#ffd268"
color-link statement "#f0b849"
color-link preproc "#fed268"
color-link type "#ffd268"
color-link special "#cbb06d"
color-link underlined "underline #f0b849"
color-link symbol "#f0b849"
color-link divider "#2e2414"
