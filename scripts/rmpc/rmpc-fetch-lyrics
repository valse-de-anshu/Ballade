#!/usr/bin/env python3
# rmpc-fetch-lyrics: Robust synchronized lyrics discoverer and fetcher for rmpc/mpd.
# - Discovers lyrics right inside the song's folder (e.g. <folder>/lyrics/<song>.lrc or <folder>/<song>.lrc).
# - Automatically adds [ti: ...] and [ar: ...] tags required by rmpc's indexer.
# - Fetches from LRCLIB when no local lyrics exist and saves into <folder>/lyrics/.
# - Auto-heals missing ID3 tags on untagged audio files so rmpc never sees "Unknown" artist.
# - Notifies running rmpc instances to index and display lyrics immediately.

import sys, os, json, re, urllib.request, urllib.parse, subprocess, shutil

def normalize_name(s):
    """Normalize string for fuzzy matching (lowercase alphanumeric only)."""
    return re.sub(r'[^a-z0-9]', '', s.lower())

def ensure_metadata_tags(lrc_path, title, artist, album=""):
    """Ensure the .lrc file has [ti: ...] and [ar: ...] tags so rmpc can index it."""
    try:
        with open(lrc_path, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()

        has_ti = bool(re.search(r'\[ti:[^\]]+\]', content, re.IGNORECASE))
        has_ar = bool(re.search(r'\[ar:[^\]]+\]', content, re.IGNORECASE))

        if not has_ti or not has_ar:
            tags = []
            if not has_ti and title:
                tags.append(f"[ti:{title}]")
            if not has_ar and artist:
                tags.append(f"[ar:{artist}]")
            if album and not re.search(r'\[al:[^\]]+\]', content, re.IGNORECASE):
                tags.append(f"[al:{album}]")

            if tags:
                new_content = "\n".join(tags) + "\n" + content
                with open(lrc_path, 'w', encoding='utf-8') as f:
                    f.write(new_content)
    except Exception:
        pass

def notify_rmpc(lrc_path, pid=None):
    """Notify rmpc via remote IPC that lyrics are available."""
    try:
        cmd = ["rmpc", "remote"]
        if pid:
            cmd.extend(["--pid", str(pid)])
        cmd.extend(["indexlrc", "--path", lrc_path])
        subprocess.run(cmd, capture_output=True, text=True, timeout=2)
    except Exception:
        pass

def repair_audio_tags_if_needed(abs_path, title, artist):
    """If the audio file is completely missing ID3/FLAC title/artist, write them."""
    if not abs_path or not os.path.isfile(abs_path) or not title:
        return
    try:
        import mutagen
        audio = mutagen.File(abs_path, easy=True)
        if audio is None:
            return
        cur_title = audio.get('title', [None])[0]
        cur_artist = audio.get('artist', [None])[0]
        needs_save = False
        if not cur_title:
            audio['title'] = title
            needs_save = True
        if not cur_artist and artist:
            audio['artist'] = artist
            needs_save = True
        if needs_save:
            audio.save()
            # Inform MPD to update metadata for this file in background
            subprocess.Popen(["rmpc", "update"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def sync_all_lyrics_tags():
    """Scan music directories to ensure all .lrc files have [ti: ...] and [ar: ...] tags and populate lyrics hub."""
    roots = [
        os.path.join(os.environ.get("RMPC_EXTERNAL_DRIVE", "/mnt/storage"), "portable_music"),
        "/mnt/storage/portable_music",
        os.path.expanduser("~/Music/internal_music")
    ]
    hub_dir = os.path.expanduser("~/.local/share/rmpc/lyrics")
    os.makedirs(hub_dir, exist_ok=True)
    seen = set()
    for root in roots:
        if not os.path.isdir(root) or root in seen:
            continue
        seen.add(root)
        for dirpath, _, filenames in os.walk(root):
            for fname in filenames:
                if not fname.endswith(".lrc"):
                    continue
                fpath = os.path.join(dirpath, fname)
                stem = os.path.splitext(fname)[0]
                title = stem
                artist = ""
                if " - " in stem:
                    parts = stem.split(" - ", 1)
                    title = parts[0].strip()
                    artist = parts[1].strip()
                else:
                    parent_dir = os.path.dirname(fpath) if os.path.basename(dirpath) == "lyrics" else dirpath
                    parent = os.path.basename(parent_dir)
                    if parent and parent not in ("portable_music", "internal_music", "Music", "lyrics"):
                        artist = "Lana Del Rey" if parent == "lana del ray" else parent
                ensure_metadata_tags(fpath, title, artist)

                # Maintain direct file symlink in unified hub for rmpc startup indexer
                link_path = os.path.join(hub_dir, fname)
                try:
                    if not os.path.lexists(link_path):
                        os.symlink(fpath, link_path)
                except Exception:
                    pass


def main():
    try:
        if "--sync-all" in sys.argv:
            sync_all_lyrics_tags()
            sys.exit(0)

        # 1. Retrieve current song information

        song = {}
        try:
            res = subprocess.run(["rmpc", "song"], capture_output=True, text=True, timeout=2)
            if res.returncode == 0 and res.stdout.strip():
                song = json.loads(res.stdout)
        except Exception:
            pass

        file_path = song.get("file", "") or os.environ.get("FILE", "")
        if not file_path:
            sys.exit(0)

        metadata = song.get("metadata", {}) if isinstance(song, dict) else {}
        artist = metadata.get("artist", "") or os.environ.get("ARTIST", "") or ""
        title = metadata.get("title", "") or os.environ.get("TITLE", "") or ""
        album = metadata.get("album", "") or os.environ.get("ALBUM", "") or ""
        pid = os.environ.get("PID", "")

        base_name = os.path.splitext(os.path.basename(file_path))[0]

        # 2. Resolve absolute song path and directories
        candidate_roots = [
            os.environ.get("RMPC_EXTERNAL_DRIVE", "/mnt/storage"),
            "/mnt/storage",
            os.path.expanduser("~/Music")
        ]

        abs_file_path = None
        if os.path.isabs(file_path) and os.path.exists(file_path):
            abs_file_path = os.path.realpath(file_path)
        else:
            for root in candidate_roots:
                p = os.path.realpath(os.path.join(root, file_path))
                if os.path.exists(p):
                    abs_file_path = p
                    break

        if not abs_file_path:
            abs_file_path = os.path.realpath(os.path.join(candidate_roots[0], file_path))

        song_dir = os.path.dirname(abs_file_path)
        song_lyrics_dir = os.path.join(song_dir, "lyrics")

        # Parse and infer title and artist if missing or unhelpful
        if not title or title == base_name or not artist or artist.lower() in ("unknown", "none"):
            if " - " in base_name:
                parts = base_name.split(" - ", 1)
                if not title or title == base_name:
                    title = parts[0].strip()
                if not artist or artist.lower() in ("unknown", "none"):
                    artist = parts[1].strip()
            elif not title:
                title = base_name

        if not artist or artist.lower() in ("unknown", "none"):
            parent_name = os.path.basename(song_dir)
            if parent_name and parent_name not in ("portable_music", "internal_music", "Music"):
                if parent_name == "lana del ray":
                    artist = "Lana Del Rey"
                else:
                    artist = parent_name

        # Auto-heal audio tags if missing
        repair_audio_tags_if_needed(abs_file_path, title, artist)

        # 3. Search for existing lyrics
        search_dirs = [song_lyrics_dir, song_dir]
        external_lyrics = os.path.join(os.environ.get("RMPC_EXTERNAL_DRIVE", "/mnt/storage"), "portable_music/lyrics")
        internal_lyrics = os.path.expanduser("~/Music/internal_music/lyrics")
        for fb in [external_lyrics, internal_lyrics]:
            if fb not in search_dirs and os.path.isdir(fb):
                search_dirs.append(fb)

        matched_lrc = None
        exact_names = [
            f"{base_name}.lrc",
            f"{title}.lrc",
            f"{title} - {artist}.lrc" if artist else None,
            f"{artist} - {title}.lrc" if artist else None
        ]
        exact_names = [n for n in exact_names if n]

        # Check exact names first
        for sdir in search_dirs:
            if not os.path.isdir(sdir):
                continue
            for name in exact_names:
                cand = os.path.join(sdir, name)
                if os.path.isfile(cand) and os.path.getsize(cand) > 0:
                    matched_lrc = cand
                    break
            if matched_lrc:
                break

        # Fuzzy / normalized check if not found
        if not matched_lrc:
            norm_base = normalize_name(base_name)
            norm_title = normalize_name(title)
            for sdir in search_dirs:
                if not os.path.isdir(sdir):
                    continue
                try:
                    for f in os.listdir(sdir):
                        if not f.endswith(".lrc"):
                            continue
                        f_stem = os.path.splitext(f)[0]
                        norm_f = normalize_name(f_stem)
                        if norm_f in (norm_base, norm_title) or (norm_title and (norm_f.startswith(norm_title) or norm_title.startswith(norm_f))):
                            matched_lrc = os.path.join(sdir, f)
                            break
                except Exception:
                    pass
                if matched_lrc:
                    break

        # If found in a fallback directory but not in song_lyrics_dir, copy to song_lyrics_dir
        if matched_lrc and os.path.dirname(matched_lrc) != song_lyrics_dir:
            try:
                os.makedirs(song_lyrics_dir, exist_ok=True)
                dest = os.path.join(song_lyrics_dir, f"{base_name}.lrc")
                if not os.path.exists(dest):
                    shutil.copyfile(matched_lrc, dest)
                    matched_lrc = dest
            except Exception:
                pass

        # 4. If lyrics exist, ensure metadata tags & notify rmpc
        if matched_lrc and os.path.isfile(matched_lrc) and os.path.getsize(matched_lrc) > 0:
            ensure_metadata_tags(matched_lrc, title, artist, album)
            notify_rmpc(matched_lrc, pid)
            sys.exit(0)

        # 5. Fetch from LRCLIB API if not found
        params = {"track_name": title}
        if artist:
            params["artist_name"] = artist
        if album:
            params["album_name"] = album
        url = f"https://lrclib.net/api/get?{urllib.parse.urlencode(params)}"

        req = urllib.request.Request(url, headers={"User-Agent": "rmpc-lyrics-fetcher/2.0"})
        lyrics_content = None
        try:
            with urllib.request.urlopen(req, timeout=4) as response:
                if response.status == 200:
                    data = json.loads(response.read().decode("utf-8"))
                    lyrics_content = data.get("syncedLyrics") or data.get("plainLyrics")
        except Exception:
            pass

        if not lyrics_content:
            query_str = f"{artist} {title}".strip() if artist else title
            search_url = f"https://lrclib.net/api/search?{urllib.parse.urlencode({'q': query_str})}"
            search_req = urllib.request.Request(search_url, headers={"User-Agent": "rmpc-lyrics-fetcher/2.0"})
            try:
                with urllib.request.urlopen(search_req, timeout=4) as response:
                    if response.status == 200:
                        data = json.loads(response.read().decode("utf-8"))
                        if isinstance(data, list) and len(data) > 0:
                            lyrics_content = data[0].get("syncedLyrics") or data[0].get("plainLyrics")
            except Exception:
                pass

        if lyrics_content and lyrics_content.strip():
            os.makedirs(song_lyrics_dir, exist_ok=True)
            target_lrc = os.path.join(song_lyrics_dir, f"{base_name}.lrc")
            
            tags = [f"[ti:{title}]"]
            if artist:
                tags.append(f"[ar:{artist}]")
            if album:
                tags.append(f"[al:{album}]")
            full_content = "\n".join(tags) + "\n" + lyrics_content

            with open(target_lrc, "w", encoding="utf-8") as f:
                f.write(full_content)

            notify_rmpc(target_lrc, pid)

    except Exception:
        pass

    sys.exit(0)

if __name__ == "__main__":
    main()
