# Ballade Grayscale (Nord Dark) micro colorscheme
color-link default "#d8dee9,#242933"
color-link colorcolumn "#d8dee9,#2e3440"
color-link line-number "#4c566a,#242933"
color-link current-line-number "#88c0d0,#242933"
color-link cursor-line "#d8dee9,#2e3440"
color-link statusline "#eceff4,#2e3440"
color-link statusline.error "#bf616a,#2e3440"
color-link tabbar "#4c566a,#2e3440"
color-link tab-active "#eceff4,#242933"
color-link tab-inactive "#4c566a,#2e3440"
color-link error "#bf616a"
color-link warning "#ebcb8b"
color-link todo "#b48ead"
color-link selection "#eceff4,#434c5e"
color-link search-result "#242933,#88c0d0"
color-link diff-added "#a3be8c"
color-link diff-removed "#bf616a"
color-link diff-modified "#ebcb8b"
color-link comment "#4c566a"
color-link comment.hashbang "#4c566a"
color-link constant "#ebcb8b"
color-link constant.number "#d08770"
color-link constant.bool "#d08770"
color-link constant.string "#a3be8c"
color-link constant.string.url "#88c0d0"
color-link constant.specialChar "#b48ead"
color-link identifier "#d8dee9"
color-link identifier.var "#d8dee9"
color-link identifier.macro "#b48ead"
color-link identifier.class "#81a1c1"
color-link statement "#81a1c1"
color-link preproc "#88c0d0"
color-link type "#8fbcbb"
color-link special "#88c0d0"
color-link underlined "underline #88c0d0"
color-link symbol "#81a1c1"
color-link divider "#2e3440"
