# Ballade Warm Sunset Orange micro colorscheme
color-link default "#e8dcd5,#1c1512"
color-link colorcolumn "#e8dcd5,#261c18"
color-link line-number "#6b4e42,#1c1512"
color-link current-line-number "#ff9248,#1c1512"
color-link cursor-line "#e8dcd5,#261c18"
color-link statusline "#1c1512,#ff9248"
color-link statusline.error "#ffffff,#cf5d44"
color-link tabbar "#e8dcd5,#2f201a"
color-link tab-active "#1c1512,#ff9248"
color-link tab-inactive "#e8dcd5,#2f201a"
color-link error "#cf5d44"
color-link warning "#f7bb63"
color-link todo "#ff9248"
color-link selection "#1c1512,#ff9248"
color-link search-result "#1c1512,#f7bb63"
color-link diff-added "#9fb865"
color-link diff-removed "#cf5d44"
color-link diff-modified "#f7bb63"
color-link comment "#7a594c"
color-link comment.hashbang "#7a594c"
color-link constant "#f7bb63"
color-link constant.number "#f7a26d"
color-link constant.bool "#f7a26d"
color-link constant.string "#9fb865"
color-link constant.string.url "#d49a7a"
color-link constant.specialChar "#ff9248"
color-link identifier "#e8dcd5"
color-link identifier.var "#e8dcd5"
color-link identifier.macro "#ff9248"
color-link identifier.class "#f7bb63"
color-link statement "#ff9248"
color-link preproc "#f7bb63"
color-link type "#f7bb63"
color-link special "#d49a7a"
color-link underlined "underline #ff9248"
color-link symbol "#ff9248"
color-link divider "#2f201a"
