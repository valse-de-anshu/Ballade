# Ballade Red (Crimson Dark) micro colorscheme
color-link default "#ffebee,#1a1112"
color-link colorcolumn "#ffebee,#291819"
color-link line-number "#7a4548,#1a1112"
color-link current-line-number "#e57373,#1a1112"
color-link cursor-line "#ffebee,#291819"
color-link statusline "#ffffff,#3b1e20"
color-link statusline.error "#ff1744,#3b1e20"
color-link tabbar "#ef9a9a,#3b1e20"
color-link tab-active "#ffffff,#1a1112"
color-link tab-inactive "#ef9a9a,#3b1e20"
color-link error "#ff1744"
color-link warning "#ffb74d"
color-link todo "#ff5252"
color-link selection "#ffffff,#4d2225"
color-link search-result "#1a1112,#e57373"
color-link diff-added "#81c784"
color-link diff-removed "#ff1744"
color-link diff-modified "#ffb74d"
color-link comment "#7a4548"
color-link comment.hashbang "#7a4548"
color-link constant "#ffb74d"
color-link constant.number "#ff8a80"
color-link constant.bool "#ff8a80"
color-link constant.string "#ef9a9a"
color-link constant.string.url "#e57373"
color-link constant.specialChar "#d32f2f"
color-link identifier "#ffebee"
color-link identifier.var "#ffebee"
color-link identifier.macro "#ff5252"
color-link identifier.class "#d32f2f"
color-link statement "#d32f2f"
color-link preproc "#e57373"
color-link type "#d32f2f"
color-link special "#ff5252"
color-link underlined "underline #e57373"
color-link symbol "#d32f2f"
color-link divider "#291819"
