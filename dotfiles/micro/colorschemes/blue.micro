# Ballade Blue (Tokyo Night Dark) micro colorscheme
color-link default "#c0caf5,#1a1b26"
color-link colorcolumn "#c0caf5,#24283b"
color-link line-number "#565f89,#1a1b26"
color-link current-line-number "#7aa2f7,#1a1b26"
color-link cursor-line "#c0caf5,#24283b"
color-link statusline "#c0caf5,#1f2335"
color-link statusline.error "#f7768e,#1f2335"
color-link tabbar "#565f89,#1f2335"
color-link tab-active "#c0caf5,#1a1b26"
color-link tab-inactive "#565f89,#1f2335"
color-link error "#f7768e"
color-link warning "#e0af68"
color-link todo "#bb9af7"
color-link selection "#c0caf5,#283457"
color-link search-result "#1a1b26,#7aa2f7"
color-link diff-added "#9ece6a"
color-link diff-removed "#f7768e"
color-link diff-modified "#e0af68"
color-link comment "#565f89"
color-link comment.hashbang "#565f89"
color-link constant "#e0af68"
color-link constant.number "#ff9e64"
color-link constant.bool "#ff9e64"
color-link constant.string "#9ece6a"
color-link constant.string.url "#7dcfff"
color-link constant.specialChar "#bb9af7"
color-link identifier "#c0caf5"
color-link identifier.var "#c0caf5"
color-link identifier.macro "#bb9af7"
color-link identifier.class "#7aa2f7"
color-link statement "#bb9af7"
color-link preproc "#7dcfff"
color-link type "#7aa2f7"
color-link special "#7dcfff"
color-link underlined "underline #7aa2f7"
color-link symbol "#7aa2f7"
color-link divider "#24283b"
