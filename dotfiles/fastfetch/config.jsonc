{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/current_logo.png",
    "type": "kitty",
    "width": 30,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;146;72"
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "○"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": " 󰣇  {user-name} @ {host-name}",
      "color": {
        "user": "38;2;247;187;99",
        "at": "38;2;255;146;72",
        "host": "38;2;247;187;99"
      }
    },
    "break",
    {
      "type": "custom",
      "format": " {#38;2;255;146;72}󰅐 SYSTEM{#}"
    },
    {
      "type": "os",
      "key": " ├── 󰣇  os          ",
      "format": "{3} ({12})"
    },
    {
      "type": "kernel",
      "key": " ├── 󰒋  kernel      ",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": " ├── 󱎫  uptime      "
    },
    {
      "type": "packages",
      "key": " └── 󰏖  pkgs        "
    },
    "break",
    {
      "type": "custom",
      "format": " {#38;2;255;146;72} DESKTOP{#}"
    },
    {
      "type": "wm",
      "key": " ├── 󱂬  wm          ",
      "format": "{1} (Wayland)"
    },
    {
      "type": "terminal",
      "key": " ├── 󰆍  term        ",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": " ├── 󱆃  shell       ",
      "format": "{1}"
    },
    {
      "type": "display",
      "key": " └── 󰍹  display     ",
      "format": "{1}x{2} @ {3}Hz"
    },
    "break",
    {
      "type": "custom",
      "format": " {#38;2;255;146;72}󰻠 HARDWARE{#}"
    },
    {
      "type": "cpu",
      "key": " ├── 󰻠  cpu         ",
      "format": "{1} ({5}c)"
    },
    {
      "type": "gpu",
      "key": " ├── 󰢮  gpu         ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " ├── 󰍛  RAM         "
    },
    {
      "type": "disk",
      "key": " ├── 󰋊  root        ",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": " ├── 󰋊  home        ",
      "folders": "/home"
    },
    {
      "type": "disk",
      "key": " ├── 󰋊  maiden      ",
      "folders": "/mnt/maiden"
    },
    {
      "type": "disk",
      "key": " └── 󰋊  storage     ",
      "folders": "/mnt/storage"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
