## CAVA Configuration — Dynamic Ballade Theme (blue)
## Source: MPD FIFO at /tmp/mpd.fifo

[general]
framerate = 60
autosens = 1
sensitivity = 150
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
method = fifo
source = /tmp/mpd.fifo
sample_rate = 44100
sample_bits = 16
channels = 2

[output]
method = noncurses
channels = mono
mono_option = average
reverse = 0
continuous_rendering = 1

[color]
gradient = 1
gradient_color_1 = '#1a1b26'
gradient_color_2 = '#24283b'
gradient_color_3 = '#414868'
gradient_color_4 = '#565f89'
gradient_color_5 = '#7aa2f7'
gradient_color_6 = '#7dcfff'
gradient_color_7 = '#b4f9f8'
gradient_color_8 = '#bb9af7'

[smoothing]
noise_reduction = 50

[eq]
1 = 1.2
2 = 1.1
3 = 1.0
4 = 1.0
5 = 0.9
