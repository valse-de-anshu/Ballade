## CAVA Configuration — Dynamic Ballade Theme (green)
## Source: MPD FIFO at /tmp/mpd.fifo

[general]
framerate = 60
autosens = 1
sensitivity = 150
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
method = fifo
source = /tmp/mpd.fifo
sample_rate = 44100
sample_bits = 16
channels = 2

[output]
method = noncurses
channels = mono
mono_option = average
reverse = 0
continuous_rendering = 1

[color]
gradient = 1
gradient_color_1 = '#18211e'
gradient_color_2 = '#2b3339'
gradient_color_3 = '#36a166'
gradient_color_4 = '#5f9182'
gradient_color_5 = '#7d9726'
gradient_color_6 = '#83c092'
gradient_color_7 = '#a7c080'
gradient_color_8 = '#dbbc7f'

[smoothing]
noise_reduction = 50

[eq]
1 = 1.2
2 = 1.1
3 = 1.0
4 = 1.0
5 = 0.9
